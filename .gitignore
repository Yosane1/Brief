# veille.jsonl et veille/ sont volontairement suivis : c'est par le dépôt que la
# matière collectée par GitHub Actions parvient à la session Claude, qui n'a pas
# accès au réseau extérieur. veille.jsonl est réécrit chaque soir ; veille/ ne
# l'est jamais, c'est lui qui permet de republier une vieille édition.

# Réglages propres au poste, pas au projet
.claude/settings.local.json

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Miroir local des images servies depuis pCloud. L'application les charge par
# leur URL (filedn.com), jamais depuis le dépôt : neuf mégaoctets de binaires
# n'y auraient que des inconvénients.
image/

# Copies de travail laissées à côté des fichiers qu'elles doublent
* - Copie*.html
* - backup.js
